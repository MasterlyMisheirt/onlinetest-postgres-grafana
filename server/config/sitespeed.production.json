{
  "slug": "default",
  "plugins": {
    "remove": ["html", "coach", "assets", "budget"]
  },
  "browsertime": {
    "iterations": 1,
    "video": false,
    "visualMetrics": false,
    "screenshot": false,
    "screenshotLCP": false,
    "screenshotLS": false,
    "pageCompleteWaitTime": 0,
    "pageCompleteCheckStartWait": 100,
    "pageCompleteCheckPollTimeout": 100,
    "pageCompleteCheck": "return window.performance.timing.loadEventEnd > 0;",
    "connectivity": {
      "profile": "native",
      "engine": "external"
    },
    "chrome": {
      "args": [
        "--headless=new",
        "--blink-settings=imagesEnabled=false",
        "--disable-dev-shm-usage",
        "--no-sandbox",
        "--disable-gpu"
      ]
    }
  }
}
